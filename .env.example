# ==============================================================================
# TaskFlow Environment Variables Template
# Copy this template or fill these variables directly in Coolify (Hostinger VPS)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Prisma & Next.js)
# ------------------------------------------------------------------------------
# For Local Docker Compose:
# DATABASE_URL="mysql://taskflow_user:taskflow_password@localhost:3306/taskflow_db"
#
# For Coolify Docker Compose (Internal Container Network):
# DATABASE_URL="mysql://taskflow_user:YOUR_SECURE_PASSWORD@mysql:3306/taskflow_db"
DATABASE_URL="mysql://taskflow_user:taskflow_password@mysql:3306/taskflow_db"

# Database credentials for MySQL Container (used in docker-compose.yml):
MYSQL_ROOT_PASSWORD=your_super_secret_root_password
MYSQL_DATABASE=taskflow_db
MYSQL_USER=taskflow_user
MYSQL_PASSWORD=your_secure_user_password

# ------------------------------------------------------------------------------
# 2. APPLICATION RUNTIME SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# ------------------------------------------------------------------------------
# 3. SMTP REAL EMAIL CONFIGURATION
# ------------------------------------------------------------------------------
# Gmail Example: Use Google Account "App Password" (16 characters, no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="TaskFlow Workspace <your_email@gmail.com>"

# Custom SMTP / Hostinger / Mailgun / SendGrid Example:
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASS=your_hostinger_email_password
# SMTP_FROM="TaskFlow Workspace <noreply@yourdomain.com>"
