generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id            String            @id @default(cuid())
  name          String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  members       WorkspaceMember[]
  users         User[]
  projects      Project[]
  activities    Activity[]
  notifications Notification[]
  sentEmails    SentEmail[]

  @@map("workspaces")
}

model User {
  id          String            @id @default(cuid())
  name        String
  email       String            @unique
  password    String            @default("$2a$10$1r2bA.3wI6/l2.5aI/E07e4sKj40QeE5vM6/m2oQ8b.V2e5qWl7C2")
  avatar      String            @db.Text
  role        String            @default("Member") // Admin, Member, Viewer
  status      String            @default("active") // active, invited, offline
  workspaceId String?
  workspace   Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberships WorkspaceMember[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("users")
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        String    @default("Member") // Admin, Member, Viewer
  status      String    @default("active") // active, invited
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, workspaceId])
  @@map("workspace_members")
}

model Project {
  id          String     @id @default(cuid())
  name        String
  icon        String     @default("🚀")
  color       String     @default("from-indigo-500 to-purple-600")
  description String     @db.Text
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tasks       Task[]
  documents   Document[]

  @@map("projects")
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String    @db.Text
  status      String    @default("todo") // backlog, todo, in_progress, review, done
  priority    String    @default("medium") // low, medium, high, urgent
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeIds String    @db.Text // JSON Array string e.g. ["usr_1", "usr_2"]
  tags        String    @db.Text // JSON Array string e.g. ["Frontend", "Design"]
  dueDate     String
  subtasks    SubTask[]
  comments    Comment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("tasks")
}

model SubTask {
  id        String  @id @default(cuid())
  title     String
  completed Boolean @default(false)
  taskId    String
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("subtasks")
}

model Comment {
  id        String   @id @default(cuid())
  authorId  String
  text      String   @db.Text
  createdAt DateTime @default(now())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Document {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  icon      String   @default("📄")
  blocks    String   @db.LongText // JSON Array string of DocBlock
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("documents")
}

model Activity {
  id          String     @id @default(cuid())
  userId      String
  action      String
  target      String
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  timestamp   DateTime   @default(now())

  @@map("activities")
}

model Notification {
  id          String     @id @default(cuid())
  userId      String
  title       String
  message     String     @db.Text
  type        String     @default("task")
  read        Boolean    @default(false)
  linkTaskId  String?
  linkDocId   String?
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@map("notifications")
}

model SentEmail {
  id          String     @id @default(cuid())
  to          String
  subject     String
  html        String     @db.LongText
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sentAt      DateTime   @default(now())
  type        String

  @@map("sent_emails")
}
